            "sql": "SELECT store_id, COUNT(*) as total_sales, SUM(total_amount) as total_revenue, AVG(total_amount) as avg_order FROM store_sales WHERE store_id IN %s AND sale_date >= CURRENT_DATE - INTERVAL '7 days' GROUP BY store_id ORDER BY store_id",
