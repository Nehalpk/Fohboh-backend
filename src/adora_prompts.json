            "sql": "SELECT store_id, COUNT(*) as total_sales, SUM(total_amount) as total_revenue FROM store_sales WHERE store_id IN %s AND sale_date = CURRENT_DATE - INTERVAL '1 day' GROUP BY store_id ORDER BY store_id",
