                "sales on date",
                "revenue on date",
                "transactions on date",
                "orders on date",
                "business on date"
            ],
            "requires_date": true,
            "sql": "SELECT r.name as restaurant_name, COUNT(sg.id) as transaction_count, COALESCE(SUM(sg.subtotal), 0) as total_subtotal, COALESCE(SUM(sg.total_amount), 0) as total_amount, COALESCE(AVG(sg.subtotal), 0) as avg_subtotal, COALESCE(SUM(sg.tip), 0) as total_tips FROM restaurants r LEFT JOIN sales_graphs sg ON sg.restaurant_id = r.id WHERE r.name = ANY(%s::text[]) AND DATE(sg.created_at) = %s GROUP BY r.name ORDER BY r.name",
            "category": "sales"
        },
