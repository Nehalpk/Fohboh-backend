                "what were sales on"
            ],
            "requires_keyword": true,
            "sql": "SELECT store_id, COUNT(*) as total_sales, SUM(total_amount) as total_revenue FROM store_sales WHERE store_id IN %s AND sale_date = %s GROUP BY store_id ORDER BY store_id",
            "response": "Sales by store for specified date: {results}"
