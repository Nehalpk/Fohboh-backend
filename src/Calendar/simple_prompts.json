{
    "prompts": [
        {
            "id": "count_inventory",
            "text_patterns": [
                "how many inventory",
                "count inventory items",
                "count inventory",
                "number of inventory",
                "inventory count",
                "total inventory",
                "count inventory rows"
            ],
            "sql": "SELECT r.name as restaurant_name, COUNT(ig.id) as total_rows FROM restaurants r LEFT JOIN inventory_graphs ig ON ig.restaurant_id = r.id WHERE r.name = ANY(%s::text[]) GROUP BY r.name ORDER BY r.name",
            "category": "inventory"
        },
        {
            "id": "list_unique_ingredients",
            "text_patterns": [
                "unique ingredients",
                "distinct ingredients",
                "different ingredients",
                "all unique ingredients"
            ],
            "sql": "SELECT r.name as restaurant_name, ig.ingredient FROM restaurants r LEFT JOIN inventory_graphs ig ON ig.restaurant_id = r.id WHERE r.name = ANY(%s::text[]) AND ig.ingredient IS NOT NULL GROUP BY r.name, ig.ingredient ORDER BY r.name, ig.ingredient",
            "category": "inventory"
        },
        {
            "id": "list_all_ingredients",
            "text_patterns": [
                "list ingredients",
                "show ingredients",
                "all ingredients",
                "what ingredients",
                "show me ingredients"
            ],
            "sql": "SELECT r.name as restaurant_name, ig.ingredient, ig.quantity, ig.unit_cost FROM restaurants r LEFT JOIN inventory_graphs ig ON ig.restaurant_id = r.id WHERE r.name = ANY(%s::text[]) AND ig.ingredient IS NOT NULL ORDER BY r.name, ig.ingredient LIMIT 100",
            "category": "inventory"
        },
        {
            "id": "ingredient_quantity_total",
            "text_patterns": [
                "total quantity of",
                "how much of ingredient",
                "quantity for ingredient",
                "sum quantity",
                "total stock of"
            ],
            "requires_keyword": true,
            "sql": "SELECT r.name as restaurant_name, ig.ingredient, SUM(ig.quantity) as total_quantity, COUNT(ig.id) as entry_count FROM restaurants r LEFT JOIN inventory_graphs ig ON ig.restaurant_id = r.id WHERE r.name = ANY(%s::text[]) AND ig.ingredient ILIKE %s GROUP BY r.name, ig.ingredient ORDER BY r.name, total_quantity DESC",
            "category": "inventory"
        },
        {
            "id": "top_menu_items_by_sales",
            "text_patterns": [
                "top menu items by sales",
                "best menu items",
                "top selling menu items",
                "best selling menu items",
                "most popular menu items",
                "highest revenue menu items",
                "top dishes by sales",
                "most ordered menu items",
                "top 3 menu items",
                "top 5 menu items",
                "top 10 menu items"
            ],
            "sql": "SELECT r.name as restaurant_name, sg.items_sold, COUNT(DISTINCT sg.id) as times_ordered, SUM(sg.number_of_items) as total_quantity, SUM(sg.subtotal) as total_revenue, AVG(sg.subtotal) as avg_order_value FROM restaurants r LEFT JOIN sales_graphs sg ON sg.restaurant_id = r.id WHERE r.name = ANY(%s::text[]) AND sg.items_sold IS NOT NULL AND sg.created_at >= CURRENT_DATE - INTERVAL '7 days' GROUP BY r.name, sg.items_sold ORDER BY total_revenue DESC LIMIT 3",
            "category": "sales",
            "supports_dynamic": true
        },
        {
            "id": "low_stock",
            "text_patterns": [
                "low stock",
                "items low",
                "what is low",
                "running low",
                "low inventory"
            ],
            "sql": "SELECT r.name as restaurant_name, ig.ingredient, ig.quantity FROM restaurants r LEFT JOIN inventory_graphs ig ON ig.restaurant_id = r.id WHERE r.name = ANY(%s::text[]) AND ig.alert = 'low' ORDER BY r.name, ig.quantity ASC LIMIT 20",
            "category": "inventory"
        },
        {
            "id": "search_ingredient",
            "text_patterns": [
                "find ingredient",
                "search ingredient",
                "look for ingredient",
                "do we have"
            ],
            "requires_keyword": true,
            "sql": "SELECT r.name as restaurant_name, ig.ingredient, ig.quantity, ig.unit_cost FROM restaurants r LEFT JOIN inventory_graphs ig ON ig.restaurant_id = r.id WHERE r.name = ANY(%s::text[]) AND ig.ingredient ILIKE %s ORDER BY r.name LIMIT 10",
            "category": "inventory"
        },
        {
            "id": "sales_on_date",
