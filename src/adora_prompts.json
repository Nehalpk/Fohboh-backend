{
    "prompts": [
        {
            "id": "adora_count_inventory",
            "text_patterns": [
                "how many inventory",
                "count inventory items",
                "number of inventory",
                "inventory count",
                "total inventory",
                "what is the total inventory",
                "what's the total inventory",
                "how much inventory"
            ],
            "sql": "SELECT store_id, COUNT(*) as total FROM store_inventory WHERE store_id IN %s GROUP BY store_id ORDER BY store_id",
            "response": "Inventory counts by store: {results}"
        },
        {
            "id": "adora_list_ingredients",
            "text_patterns": [
                "list ingredients",
                "show ingredients",
                "all ingredients",
                "what ingredients",
                "show me ingredients"
            ],
            "sql": "SELECT DISTINCT store_id, ingredient FROM store_inventory WHERE store_id IN %s ORDER BY store_id, ingredient",
            "response": "Ingredients by store:\n{ingredients_list}"
        },
        {
            "id": "adora_average_tip",
            "text_patterns": [
                "average tip",
                "avg tip",
                "tip percentage",
                "average tip percentage",
                "tip percent"
            ],
            "sql": "SELECT store_id, AVG((tip / NULLIF(total_amount, 0)) * 100) as avg_tip_percentage, COUNT(*) as total_orders, SUM(tip) as total_tips FROM store_sales WHERE store_id IN %s AND tip IS NOT NULL AND total_amount > 0 GROUP BY store_id ORDER BY store_id",
            "supports_date_filtering": true,
            "date_column": "sale_date",
            "response": "Average tip percentage by store: {results}"
        },
        {
            "id": "adora_menu_by_category",
            "text_patterns": [
                "menu items in each category",
                "menu by category",
                "items in each category",
                "menu categories",
                "category breakdown",
                "how many menu items in each",
                "menu balance",
                "balanced menu"
            ],
            "sql": "SELECT store_id, category, COUNT(DISTINCT menu_item) as item_count, STRING_AGG(DISTINCT menu_item, ', ') as items FROM store_menu WHERE store_id IN %s AND category IS NOT NULL GROUP BY store_id, category ORDER BY store_id, item_count DESC",
            "response": "Menu items by category: {results}"
        },
        {
            "id": "adora_low_stock",
            "text_patterns": [
                "low stock",
                "items low",
                "what is low",
                "running low",
                "low inventory",
                "items running low",
                "what needs reordering"
            ],
            "sql": "SELECT store_id, ingredient, quantity, par_level, (par_level - quantity) as shortage FROM store_inventory WHERE store_id IN %s AND quantity < par_level ORDER BY store_id, (quantity / NULLIF(par_level, 1)) ASC",
            "response": "**Low stock items by store:**\n{items_list}"
        },
        {
            "id": "adora_search_ingredient",
            "text_patterns": [
                "find ",
                "search for ",
                "look for ",
                "do we have ",
                "do you have "
            ],
            "requires_keyword": true,
            "sql": "SELECT store_id, ingredient, quantity FROM store_inventory WHERE store_id IN %s AND ingredient ILIKE %s ORDER BY store_id",
            "response": "Found {count} result(s) across stores:\n{results}"
        },
        {
            "id": "adora_total_inventory_value",
            "text_patterns": [
                "total value",
                "inventory value",
                "worth of inventory",
                "value of stock",
                "how much is inventory worth"
            ],
            "sql": "SELECT store_id, SUM(quantity * unit_cost) as total_value FROM store_inventory WHERE store_id IN %s AND unit_cost IS NOT NULL GROUP BY store_id ORDER BY store_id",
            "response": "Total inventory value by store: {results}"
        },
        {
